{
  "name": "aera-beauty-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AERA Beauty Studio — Contemporary Soft-Luxury Beauty Sanctuary & Reusable Salon Showcase",
  "scripts": {
    "dev": "vite",
    "optimize:media": "node scripts/optimize-media.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && rm -rf dist-ssr",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "@fontsource-variable/syne": "^5.2.5",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.12.7",
    "lenis": "^1.2.3",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
